---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bilingual from '../../components/Bilingual.astro';
import NewsCard from '../../components/NewsCard.astro';
import EventCard from '../../components/EventCard.astro';
import FacebookFeed from '../../components/FacebookFeed.astro';
import { getCollection } from 'astro:content';
import { sortByDateDesc, upcomingEvents } from '../../lib/content';
import { site } from '../../config';

const posts = sortByDateDesc(await getCollection('news'));
const upcoming = upcomingEvents(await getCollection('events'));
---

<BaseLayout title="News">
  <section class="page-hero">
    <div class="container">
      <h1>News <span lang="uk">(Новини)</span></h1>
      <Bilingual class="bilingual-stacked">
        <Fragment slot="en">Updates and announcements from CANUG.</Fragment>
        <Fragment slot="uk">Оновлення та оголошення CANUG.</Fragment>
      </Bilingual>
    </div>
  </section>

  {
    upcoming.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-header">
            <h2>Upcoming events <span lang="uk">(Найближчі події)</span></h2>
          </div>
          <div class="card-grid">
            {upcoming.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="card-grid">
            {posts.map((post) => (
              <NewsCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <Bilingual>
              <Fragment slot="en">No news posts yet.</Fragment>
              <Fragment slot="uk">Новин поки немає.</Fragment>
            </Bilingual>
          </div>
        )
      }
    </div>
  </section>

</BaseLayout>
