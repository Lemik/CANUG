---
import type { CollectionEntry } from 'astro:content';
import Bilingual from './Bilingual.astro';
import { formatDate } from '../lib/content';

interface Props {
  event: CollectionEntry<'events'>;
  href?: string;
}

const { event, href = `/events/${event.id}/` } = Astro.props;
const { data } = event;
---

<article class="card">
  {data.image && <img class="card-media" src={data.image} alt="" loading="lazy" decoding="async" />}
  <div class="card-body">
    <p class="card-meta">
      <time datetime={data.date.toISOString()}>{formatDate(data.date, 'en')}</time>
      <span aria-hidden="true"> · </span>
      <time lang="uk" datetime={data.date.toISOString()}>{formatDate(data.date, 'uk')}</time>
    </p>
    <h3 class="card-title">
      <a href={href}>{data.title_en}</a>
    </h3>
    <Bilingual>
      <Fragment slot="en">{data.summary_en}</Fragment>
      <Fragment slot="uk">{data.summary_uk}</Fragment>
    </Bilingual>
  </div>
</article>
